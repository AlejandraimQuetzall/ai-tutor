# Copy this file to .env in the repository root, then put your own key on the
# LLM_API_KEY line. .env is gitignored. Do not commit it, paste it into an
# issue, or leave it in a screenshot.
#
# Full steps: docs/deploy.md and docs/deploy.zh-CN.md
# An empty LLM_API_KEY still runs the included sample course.

# Required only when you generate a path from your own files.
LLM_API_KEY=

# OpenAI-compatible root. The app calls {LLM_BASE_URL}/chat/completions.
# Do not append /chat/completions here.
LLM_BASE_URL=https://api.openai.com/v1

# Chat model for extract, arrange, lessons, and Ask.
LLM_MODEL=gpt-4o-mini

# Used only for audio and video uploads. The endpoint must implement
# {LLM_BASE_URL}/audio/transcriptions.
LLM_TRANSCRIBE_MODEL=whisper-1

# SQLite directory. A relative path is resolved from the process working
# directory. Docker Compose overrides this to /app/data, mounted at ./data.
DATA_DIR=./data
